# Plantilla de configuracion de firma de B-Chess.
# Copia este archivo como "keystore.properties" en la raiz del proyecto y
# rellena los valores reales. NO subas "keystore.properties" ni "keystore/" al
# repositorio (ya estan en .gitignore).
#
# La clave debe ser SIEMPRE la misma en todas las versiones: Android solo
# permite actualizar sin desinstalar si el paquete y la firma coinciden.
#
# storeFile: ruta al almacen de claves, relativa a la raiz del proyecto.
storeFile=keystore/bchess-release.jks
# storePassword: contrasena del almacen de claves.
storePassword=REPLACE_WITH_PRIVATE_PASSWORD
# keyAlias: alias de la clave dentro del almacen.
keyAlias=REPLACE_WITH_KEY_ALIAS
# keyPassword: contrasena de la clave.
keyPassword=REPLACE_WITH_PRIVATE_PASSWORD
